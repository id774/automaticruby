#!/bin/sh
#
########################################################################
# Local build script
#
#  Runs what CI runs, and optionally the integration recipes, which CI
#  does not run and never will: they reach real services, several of
#  which no longer exist. See doc/PLUGINS.md section 6.
#
#  Usage:
#    script/build          Run the test suite and the CLI checks.
#    script/build all      Also run the integration recipes by hand.
#
#  Author: id774 (More info: http://id774.net)
#  Source Code:: https://github.com/id774/automaticruby
#  License: The GPL version 3, or LGPL version 3 (Dual License).
#  Contact: idnanashi@gmail.com
#
#  v2.0 8/14,2026
#       Replace the Jenkins-era workflow: drop bundle update and the
#       simplecov rake task, use the -v option the CLI now has, and
#       stop unscaffolding a real user directory.
#  v1.5 6/28,2013
#       Always using latest gems.
#  v1.4 5/13,2013
#       Fix bundler environment.
#  v1.3 2/26,2013
#       Remove script/bootstrap.
#  v1.2 6/16,2012
#       Add all option for integration tests.
#  v1.1 6/14,2012
#       Correspond to unscaffold subcommand.
#  v1.0 3/16,2012
#       First.
########################################################################

set -e

ROOT_DIR=$(cd "$(dirname "$0")/.." && pwd)
cd "$ROOT_DIR"

automatic() {
    bundle exec bin/automatic "$@"
}

unit_tests() {
    ruby -v
    bundle -v
    bundle install
    automatic --version
    automatic --help > /dev/null
    bundle exec rake spec
}

# The integration recipes reach real services and are run deliberately.
# Most need a credential, a service that has shut down, or both; read the
# recipe before running it.
integration_tests() {
    for recipe in "$ROOT_DIR"/test/integration/test_*.yml
    do
        echo "=== $recipe ==="
        automatic -c "$recipe" || echo "FAILED: $recipe"
    done

    automatic opmlparser "$ROOT_DIR/test/fixtures/sampleOPML.xml" > /dev/null
    automatic log info finished.
}

main() {
    unit_tests
    test -n "$1" && integration_tests
    exit 0
}

main "$@"
