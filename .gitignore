# Bundler resolves dependencies per environment; this is a library, so the
# lock file is not committed. See doc/POLICY.md section 9.4.
Gemfile.lock
.bundle/
vendor/bundle/
vendor/gems/

# Build output
pkg/
*.gem

# Test and coverage output
coverage/
.rspec-status

# Databases written by the store plugins when ~/.automatic/db is absent
db/*.db

# Editor and tooling
tags
.rbenv-version
.ruby-version
